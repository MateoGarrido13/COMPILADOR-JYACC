Codigo fuente:
1: {{ r25: los atributos heredados participan en orden base primero.
2:    padre aporta ulongint x; hija agrega doublef y. cb declara en ese mismo
3:    orden ulongint a; doublef b. La asignacion es valida y genera
4:    (COPY, h1:main, b1:main). Sin errores.
5: }}
6: prog
7: class padre
8: begin
9:     ulongint x;
10: end;
11: class hija
12: begin
13:     extends padre;
14:     doublef y;
15: end;
16: class cb
17: begin
18:     ulongint a;
19:     doublef b;
20: end;
21: hija h1;
22: cb b1;
23: begin
24:     h1 := b1;
25: end

