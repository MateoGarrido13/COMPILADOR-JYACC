   0  $accept : programa $end

   1  programa : nombre_programa sentencias_declarativas bloque_ejecutable
   2           | bloque_ejecutable
   3           | declaracion_clara sentencias_declarativas bloque_ejecutable

   4  declaracion_clara : declaracion_variables
   5                    | declaracion_funcion
   6                    | declaracion_clase
   7                    | declaracion_typedef

   8  nombre_programa : ID

   9  bloque_ejecutable : BEGIN lista_sentencias END
  10                    | BEGIN END
  11                    | BEGIN lista_sentencias
  12                    | BEGIN error END
  13                    | END
  14                    | error END

  15  sentencias_declarativas : sentencia_declarativa sentencias_declarativas
  16                          |

  17  sentencia_declarativa : declaracion_variables
  18                        | declaracion_objetos
  19                        | declaracion_funcion
  20                        | declaracion_clase
  21                        | declaracion_typedef
  22                        | asignacion ';'
  23                        | sentencia_if
  24                        | sentencia_repeat_while
  25                        | sentencia_pout
  26                        | sentencia_ret

  27  declaracion_variables : tipo lista_variables ';'
  28                        | tipo error ';'

  29  declaracion_objetos : ID lista_variables ';'

  30  tipo : ULONGINT
  31       | DOUBLEF

  32  tipo_declarado : tipo
  33                 | ID

  34  lista_variables : ID ',' lista_variables
  35                  | ID
  36                  | ID lista_variables

  37  encabezado_funcion : tipo FUNCTION ID
  38                     | tipo FUNCTION

  39  declaracion_funcion : encabezado_funcion '(' lista_parametros_formales ')' sentencias_declarativas cierre_funcion

  40  cierre_funcion : BEGIN lista_sentencias END ';'
  41                 | BEGIN END ';'
  42                 | BEGIN lista_sentencias END
  43                 | BEGIN error END ';'
  44                 | error END ';'

  45  lista_parametros_formales : parametro_formal ',' lista_parametros_formales
  46                            | parametro_formal

  47  parametro_formal : tipo ID
  48                   | ID ID
  49                   | tipo
  50                   | ID

  51  encabezado_clase : CLASS ID

  52  declaracion_clase : encabezado_clase BEGIN cuerpo_clase END ';'
  53                    | encabezado_clase BEGIN cuerpo_clase END

  54  cuerpo_clase : miembro_clase cuerpo_clase
  55               |

  56  miembro_clase : declaracion_atributo
  57                | declaracion_metodo
  58                | sentencia_extends

  59  declaracion_atributo : tipo_declarado lista_variables ';'

  60  encabezado_metodo : tipo_declarado ID

  61  declaracion_metodo : encabezado_metodo '(' lista_parametros_formales ')' BEGIN lista_sentencias END ';'

  62  sentencia_extends : EXTENDS lista_clases_heredadas ';'
  63                    | EXTENDS ';'
  64                    | EXTENDS error ';'

  65  lista_clases_heredadas : ID ',' lista_clases_heredadas
  66                         | ID

  67  declaracion_typedef : TYPEDEF ID '=' '[' lista_valores_enumerado ']' ';'
  68                      | TYPEDEF ID '=' '[' ']' ';'

  69  lista_valores_enumerado : constante ',' lista_valores_enumerado
  70                          | constante

  71  lista_sentencias : sentencia lista_sentencias
  72                   | sentencia

  73  sentencia : asignacion ';'
  74            | asignacion
  75            | sentencia_if
  76            | sentencia_repeat_while
  77            | sentencia_pout
  78            | sentencia_ret
  79            | error ';'

  80  bloque_sentencias : sentencia
  81                    | BEGIN lista_sentencias END

  82  asignacion : ID ASIG expresion
  83             | referencia_atributo ASIG expresion
  84             | ID ASIG error

  85  sentencia_if : IF '(' condicion ')' bloque_sentencias END_IF ';'
  86               | IF '(' condicion ')' bloque_sentencias ELSE bloque_sentencias END_IF ';'
  87               | IF '(' condicion ')' bloque_sentencias END_IF
  88               | IF '(' condicion ')' bloque_sentencias ELSE bloque_sentencias END_IF
  89               | IF '(' condicion ')' bloque_sentencias error
  90               | IF '(' condicion ')' bloque_sentencias ELSE bloque_sentencias error
  91               | IF condicion ')' bloque_sentencias END_IF ';'
  92               | IF '(' condicion error bloque_sentencias END_IF ';'
  93               | IF '(' error ')' bloque_sentencias END_IF ';'

  94  condicion : expresion comparador expresion

  95  comparador : MAYOR_IGUAL
  96             | MENOR_IGUAL
  97             | IGUAL_IGUAL
  98             | DISTINTO
  99             | '>'
 100             | '<'

 101  sentencia_repeat_while : REPEAT bloque_sentencias WHILE '(' condicion ')' ';'
 102                         | REPEAT bloque_sentencias WHILE '(' condicion ')'
 103                         | REPEAT WHILE '(' condicion ')' ';'
 104                         | REPEAT bloque_sentencias error ';'
 105                         | REPEAT bloque_sentencias WHILE condicion ')' ';'
 106                         | REPEAT bloque_sentencias WHILE '(' condicion ';'

 107  sentencia_pout : POUT '(' CADENA ')' ';'
 108                 | POUT '(' expresion ')' ';'
 109                 | POUT '(' ')' ';'
 110                 | POUT '(' CADENA ')'
 111                 | POUT '(' expresion ')'

 112  sentencia_ret : RET '(' expresion ')' ';'
 113                | RET '(' expresion ')'

 114  expresion : termino '+' expresion
 115            | termino '-' expresion
 116            | termino '+' error
 117            | termino '-' error
 118            | termino CTE
 119            | termino

 120  termino : factor '*' termino
 121          | factor '/' termino
 122          | factor '*' error
 123          | factor '/' error
 124          | factor

 125  factor : ID
 126         | constante
 127         | invocacion_funcion
 128         | referencia_atributo
 129         | asignacion_en_expresion
 130         | conversion

 131  constante : CTE
 132            | '-' CTE

 133  asignacion_en_expresion : ID '=' '(' expresion ')'
 134                          | ID ASIG '(' expresion ')'

 135  conversion : TODF '(' expresion ')'

 136  invocacion_funcion : ID '(' lista_parametros_reales ')' '[' lista_orden_evaluacion ']'
 137                     | ID '(' lista_parametros_reales ')' '[' ']'
 138                     | ID '(' lista_parametros_reales ')'

 139  lista_parametros_reales : parametro_real ',' lista_parametros_reales
 140                          | parametro_real

 141  parametro_real : ID '=' expresion
 142                 | expresion

 143  lista_orden_evaluacion : CTE ',' lista_orden_evaluacion
 144                         | CTE

 145  referencia_atributo : ID '.' ID
 146                      | ID '.' ID '.' ID
 147                      | ID '.' ID '(' lista_parametros_reales ')'

