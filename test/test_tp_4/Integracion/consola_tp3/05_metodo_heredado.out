Codigo fuente:
1: {{ r31+r19: invocacion a metodo heredado prefijado objeto.clase.metodo(reales)[orden] }}
2: {{ cb y cc definen m con la misma firma; ca hereda de ambas y el prefijo desambigua }}
3: {{ el orden del tema 19 va entre corchetes despues del parentesis de cierre, igual que en funciones: [2,1] evalua primero el 2do real y despues el 1ro }}
4: prog
5: class cb
6: begin
7:     ulongint m(ulongint pa, ulongint pb)
8:     begin
9:         ret(pa);
10:     end;
11: end;
12: class cc
13: begin
14:     ulongint m(ulongint pa, ulongint pb)
15:     begin
16:         ret(pb);
17:     end;
18: end;
19: class ca
20: begin
21:     extends cb, cc;
22: end;
23: ca a1;
24: ulongint r, y;
25: begin
26:     r := a1.cb.m(1$ul, 2$ul)[2$ul, 1$ul];
27:     r := a1.cc.m(pa=3$ul, 4$ul)[1$ul, 2$ul];
28:     r := a1.cb.m(y = (5$ul), 6$ul)[2$ul, 1$ul] + a1.cc.m(7$ul, 8$ul)[1$ul, 2$ul];
29:     pout(a1.cc.m(9$ul, 10$ul)[2$ul, 1$ul]);
30: end

